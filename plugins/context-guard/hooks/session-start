#!/usr/bin/env bash
# SessionStart (compact|clear): load the handover note once, then retire it.
PROJECT_DIR="${CLAUDE_PROJECT_DIR:-$PWD}"
MEMORY_DIR="$PROJECT_DIR/.claude/compact-memory"

# A compact-memory hook in the project's settings already does this.
if grep -qs 'compact-memory' "$PROJECT_DIR/.claude/settings.json"; then
  exit 0
fi

if [ -f "$MEMORY_DIR/latest.md" ]; then
  echo "## [context-guard] Handover note from before the compaction or clear"
  echo
  cat "$MEMORY_DIR/latest.md"
  mv -f "$MEMORY_DIR/latest.md" "$MEMORY_DIR/previous.md" 2>/dev/null
fi
exit 0
